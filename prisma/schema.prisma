generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid(7))
  email      String    @unique
  firstName  String?
  lastName   String?
  userName   String?
  phone      String?
  birthDate  DateTime?
  gender     String?
  image      String?
  role       Role      @default(CUSTOMER)
  isActive   Boolean   @default(true)
  isArchived Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

model Category {
  id   String @id @default(uuid(7))
  name String
  slug String @unique
  isActive Boolean @default(true)
  position Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products ProductCategory[]


  promotionTargets PromotionTarget[]

  campaignRules CampaignSectionRule[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String  @id @default(uuid(7))
  name             String
  description      String?
  shortDescription String?
  slug             String  @unique

  status   ProductStatus @default(ACTIVE)
  isActive Boolean       @default(true)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categories ProductCategory[]
  tags       ProductTag[]
  images     ProductImage[]
  variants   ProductVariant[]
  options    ProductOption[]

  // Campaign relationship
  campaignSections CampaignSectionProduct[]

  promotionTargets PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid(7))
  productId String
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id      String  @id @default(uuid(7))
  name    String  @unique
  slug    String  @unique
  logoUrl String?

  products Product[]

  campaignRules CampaignSectionRule[]
  promotionTargets PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Tag {
  id String @id @default(uuid())

  name String @unique
  slug String @unique

  products ProductTag[]

  campaignRules CampaignSectionRule[]
  promotionTargets PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)


  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)


  assignedAt DateTime @default(now())

  @@index([categoryId])
  @@id([productId, categoryId])
  @@map("product_categories")
}

model Option {
  id   String @id @default(uuid(7))
  name String @unique // "Color" | "Size" | "RAM"

  values         OptionValue[] // all possible values
  productOptions ProductOption[] // which products use this option
  templateOptions TemplateOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("options")
}

model OptionValue {
  id       String @id @default(uuid(7))
  optionId String
  value    String // "Red" | "XL" | "8GB"

  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  variantValues VariantOptionValue[] // which variants use this value
  templateOptionValues TemplateOptionValue[]

  @@unique([optionId, value]) // no duplicate "Red" under Color
  @@index([optionId])
  @@map("option_values")
}

model ProductOption {
  productId String
  optionId  String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  Option  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@map("product_options")
}

model ProductVariant {
  id        String  @id @default(uuid(7))
  productId String
  sku       String  @unique
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionValues VariantOptionValue[] // which option values define this variant
  images       VariantImage[] // variant-specific images (optional)

  promotionTargets PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model VariantImage {
  id        String  @id @default(uuid(7))
  variantId String
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
  @@map("variant_images")
}

// ═══════════════════════════════════════════════════
//  VARIANT TEMPLATE
//  e.g. "Shoe Sizes", "T-Shirt", "Beauty Product"
// ═══════════════════════════════════════════════════

model VariantTemplate {
  id          String  @id @default(uuid(7))
  name        String  @unique
  description String?

  options TemplateOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variant_templates")
}

model TemplateOption {
  id         String @id @default(uuid(7))
  templateId String
  optionId   String

  template VariantTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  option   Option          @relation(fields: [optionId],   references: [id], onDelete: Cascade)

  values TemplateOptionValue[]

  @@unique([templateId, optionId])
  @@map("template_options")
}

model TemplateOptionValue {
  id               String @id @default(uuid(7))
  templateOptionId String
  optionValueId    String

  templateOption TemplateOption @relation(fields: [templateOptionId], references: [id], onDelete: Cascade)
  optionValue    OptionValue    @relation(fields: [optionValueId],    references: [id], onDelete: Cascade)

  @@unique([templateOptionId, optionValueId])
  @@map("template_option_values")
}


model Campaign {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?

  status CampaignStatus @default(DRAFT)

  startsAt DateTime?
  endsAt   DateTime?

  bannerUrl    String?
  thumbnailUrl String?

  isActive Boolean @default(true)

  banners     CampaignBanner[]
  sections    CampaignSection[]
  promotions  PromotionCampaign[]


  // SEO
  metaTitle       String?
  metaDescription String?
  metaImageUrl    String?

  isFeatured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt  DateTime? @db.Timestamptz

  @@index([status])
  @@index([startsAt, endsAt])
  @@index([isActive])
  @@map("campaigns")
}

model CampaignBanner {
  id         String @id @default(uuid(7))
  campaignId String

  title          String?
  imageUrl       String
  mobileImageUrl String?

  linkUrl String?

  position Int @default(0)
  isActive Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, position])
  @@index([campaignId, isActive])
  @@map("campaign_banners")
}

model CampaignSection {
  id         String @id @default(uuid())
  campaignId String

  title       String
  slug        String?
  description String?

  isActive    Boolean @default(true)
  position    Int @default(0)

  bannerUrl   String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  products CampaignSectionProduct[]
  campaignRules CampaignSectionRule[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, slug])
  @@index([campaignId, position])
  @@index([campaignId, isActive])
  @@map("campaign_sections")
}

model CampaignSectionProduct {
  sectionId String
  productId String

  position Int @default(0)

  section CampaignSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
  @@index([productId])
  @@index([sectionId, position])
  @@map("campaign_section_products")
}

model CampaignSectionRule {
  id        String @id @default(uuid(7))
  sectionId String

  categoryId String?
  brandId    String?
  tagId      String?

  matchType RuleMatchType @default(ANY)

  minPrice Decimal? @db.Decimal(10, 2)
  maxPrice Decimal? @db.Decimal(10, 2)

  section CampaignSection @relation(fields: [sectionId],references: [id],onDelete: Cascade)
  category Category? @relation(fields: [categoryId],references: [id],onDelete: SetNull)
  brand Brand? @relation(fields: [brandId],references: [id],onDelete: SetNull)
  tag Tag? @relation(fields: [tagId],references: [id],onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([sectionId])
  @@index([categoryId])
  @@index([brandId])
  @@index([tagId])
  @@map("campaign_section_rules")
}

enum RuleMatchType {
  ANY   // OR – product matches if any condition is true
  ALL   // AND – product must satisfy every non-null condition
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}


model Promotion {
  id          String          @id @default(uuid(7))

  name        String
  description String?

  type        PromotionType
  status      PromotionStatus @default(DRAFT)
  value       Decimal? @db.Decimal(10, 2)

  // for buy x get y
  buyQuantity  Int?
  getQuantity  Int?

  minOrderAmount    Decimal? @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  priority Int @default(0)

  campaigns PromotionCampaign[]
  targets   PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt, endsAt])
  @@index([isActive])
  @@map("promotions")
}

model PromotionCampaign {
  promotionId String
  campaignId  String

  promotion Promotion @relation(fields: [promotionId],references: [id],onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId],references: [id],onDelete: Cascade)

  @@id([promotionId, campaignId])
  @@index([campaignId])
  @@map("promotion_campaigns")
}

model PromotionTarget {
  id String @id @default(uuid(7))

  promotionId String
  productId String?
  variantId String?
  categoryId  String?
  brandId     String?
  tagId       String?

  targetType  PromotionTargetType

  promotion Promotion @relation(fields: [promotionId],references: [id],onDelete: Cascade)
  product Product? @relation(fields: [productId],references: [id],onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId],references: [id],onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tag Tag? @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Prevent duplicate product targets
  @@unique([promotionId, productId])
  // Prevent duplicate variant targets
  @@unique([promotionId, variantId])
  @@unique([promotionId, categoryId])
  @@unique([promotionId, brandId])
  @@unique([promotionId, tagId])

  @@index([promotionId, targetType])
  @@index([promotionId])
  @@index([productId])
  @@index([variantId])
  @@map("promotion_targets")
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  BUY_X_GET_Y
  FREE_SHIPPING
  SHIPPING_DISCOUNT
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum PromotionTargetType {
  PRODUCT
  VARIANT
  CATEGORY
  BRAND
  TAG
  ALL_PRODUCTS          // global promotion
}
